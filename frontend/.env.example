# Frontend settings are read by Vite and embedded in the browser bundle at build time.
#
# VITE_* names are preferred; the legacy API_URL / SOLANA_* names are still
# accepted. Network, RPC, WebSocket, and USDC mint defaults follow the cluster.
VITE_API_URL=http://localhost:8000
VITE_SOLANA_NETWORK=mainnet-beta
# Production builds require HTTPS API/RPC URLs, a WSS endpoint, and a dedicated
# Mainnet RPC provider. The public cluster RPCs below are development defaults.
# VITE_API_URL=https://your-api.example
# VITE_SOLANA_RPC_URL=https://your-managed-mainnet-rpc.example
# VITE_SOLANA_WS_URL=wss://your-managed-mainnet-rpc.example

# To use Devnet locally, change the network; matching RPC and mint defaults apply.
# VITE_SOLANA_NETWORK=devnet
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# VITE_SOLANA_WS_URL=wss://api.devnet.solana.com
# VITE_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# VITE_SOLANA_USDT_MINT=your-devnet-usdt-mint
# Restrict any browser-exposed RPC provider key by domain in your provider dashboard.
