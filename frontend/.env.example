# Frontend settings are read by Vite and embedded in the browser bundle at build time.
# SOLANA_NETWORK supports 'mainnet-beta' (or 'mainnet') and 'devnet', defaulting to 'mainnet-beta'.
# SOLANA_RPC_URL, SOLANA_WS_URL, and SOLANA_USDC_MINT derive automatically from SOLANA_NETWORK unless overridden.
API_URL=http://localhost:8000
SOLANA_NETWORK=mainnet-beta
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# To point local development at Devnet, change SOLANA_NETWORK=devnet (with optional custom RPC):
# SOLANA_NETWORK=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Production Vercel builds require HTTPS API_URL and SOLANA_RPC_URL (defaults to Mainnet if omitted).
# Restrict any browser-exposed RPC provider key by domain in your provider dashboard.
# API_URL=https://veil-3998494c.fastapicloud.dev
# SOLANA_NETWORK=mainnet-beta
# SOLANA_RPC_URL=https://your-mainnet-rpc-provider.example
# SOLANA_WS_URL=wss://your-mainnet-rpc-provider.example
