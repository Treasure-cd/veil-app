# Frontend settings are read by Vite and embedded in the browser bundle at build time.
API_URL=http://localhost:8000
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Optional. Defaults to a WebSocket URL derived from SOLANA_RPC_URL. Set this
# explicitly if your provider gives you a separate WebSocket endpoint.
# SOLANA_WS_URL=wss://api.devnet.solana.com

# Production builds require explicit SOLANA_NETWORK, SOLANA_RPC_URL, and API_URL.
# For a mainnet build, set these before building. Use an RPC provider endpoint
# with production capacity; its API key is exposed in the browser bundle, so
# restrict that key at the provider.
# API_URL=https://veil-3998494c.fastapicloud.dev
# SOLANA_NETWORK=mainnet-beta
# SOLANA_RPC_URL=https://your-mainnet-rpc-provider.example
# SOLANA_WS_URL=wss://your-mainnet-rpc-provider.example
# SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
