# Local development and FastAPI Cloud environment variable reference.
# Store real values in .env locally and in FastAPI Cloud's Environment Variables.

PORT=8000
DATABASE_URL_DEV=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourveil.xyz

# Solana cluster config ('mainnet-beta' / 'mainnet' or 'devnet'; defaults to mainnet-beta).
# SOLANA_RPC_URL and USDC_MINT automatically match SOLANA_NETWORK unless explicitly overridden.
# Production must use a dedicated managed Mainnet RPC instead of the public default.
SOLANA_NETWORK=mainnet-beta
# SOLANA_RPC_URL=https://your-mainnet-rpc-provider.example
# USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# SOL_MINT=So11111111111111111111111111111111111111112

# To switch the API to Solana Devnet, set SOLANA_NETWORK=devnet (with optional custom RPC):
# SOLANA_NETWORK=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# FossaPay production credentials are required by the API. Keep them in the
# deployment's encrypted environment variables, never in source control.
FOSSAPAY_BASE_URL=https://api-production.fossapay.com
# FOSSAPAY_API_KEY=
# FOSSAPAY_SECRET=
# FOSSAPAY_WEBHOOK_SECRET=

# Optional rate fallback used only when CoinGecko is unavailable.
# RATE_NGN_PER_SOL=0
# RATE_NGN_PER_USDC=0

# Optional integrations.
# WASENDER_API_KEY=
# SQL_ECHO=false

# Meta WhatsApp Cloud API credentials.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_PHONE_NUMBER=
FRONTEND_URL=https://yourveil.vercel.app

# WhatsApp links accept USDC and, by default, FossaPay bank transfer.
# Use "usdc" to disable FossaPay; private payments require USDC only.
WHATSAPP_PAYMENT_METHODS=usdc,fossapay
WHATSAPP_PRIVATE_PAYMENTS=false

# Optional demo access. Signed-in test users receive demo payments in their own wallet.
# The wallet below is only a fallback for anonymous demo requests, with the cap below.
WHATSAPP_DEMO_MODE=false
WHATSAPP_DEMO_MAX_NUMBERS=10
# WHATSAPP_DEMO_MERCHANT_WALLET=

# Optional Gemini API key for natural-language WhatsApp fallback parsing.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
