# Local development and FastAPI Cloud environment variable reference.
# Store real values in .env locally and in FastAPI Cloud's Environment Variables.

PORT=8000
DATABASE_URL_DEV=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:5173

# Solana devnet defaults (override for a different cluster/RPC).
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOL_MINT=So11111111111111111111111111111111111111112

# Optional rate fallback used only when CoinGecko is unavailable.
# RATE_NGN_PER_SOL=0
# RATE_NGN_PER_USDC=0

# Optional integrations.
# WASENDER_API_KEY=
# SQL_ECHO=false

# Twilio WhatsApp Sandbox webhook. WEBHOOK_PUBLIC_URL must exactly match the
# public URL configured in Twilio, including /v1/whatsapp/webhook.
# TWILIO_AUTH_TOKEN=
# WEBHOOK_PUBLIC_URL=https://api.example.com/v1/whatsapp/webhook
# FRONTEND_URL=https://veil.app
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SANDBOX_JOIN_CODE=join your-sandbox-code

# Optional demo access. Signed-in test users receive demo payments in their own wallet.
# The wallet below is only a fallback for anonymous demo requests, with the cap below.
WHATSAPP_DEMO_MODE=false
WHATSAPP_DEMO_MAX_NUMBERS=10
# WHATSAPP_DEMO_MERCHANT_WALLET=
