# Local development and FastAPI Cloud environment variable reference.
# Store real values in .env locally and in FastAPI Cloud's Environment Variables.

PORT=8000
DATABASE_URL_DEV=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:5173

# Solana devnet defaults (override for a different cluster/RPC).
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOL_MINT=So11111111111111111111111111111111111111112

# Optional rate fallback used only when CoinGecko is unavailable.
# RATE_NGN_PER_SOL=0
# RATE_NGN_PER_USDC=0

# Optional integrations.
# WASENDER_API_KEY=
# SQL_ECHO=false
